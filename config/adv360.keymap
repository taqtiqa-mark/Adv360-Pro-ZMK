/*
 * Programmer Dvorak Core Keymap Configuration for Kinesis Advantage360 Pro (ZMK v3.0)
 * Top Row: Symbols natively, Numbers via Shift Mod-Morphs
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        // Standard Homerow Mods for comfortable programming shortcuts
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // --- Programmer Dvorak Mod-Morph Definitions ---
        // Format: Tapping normally sends symbol, Tapping with SHIFT sends number.
        pd_amp: pd_amp { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp AMPERSAND>, <&kp N7>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_lbrc: pd_lbrc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LEFT_BRACKET>, <&kp N5>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_lbrace: pd_lbrace { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LEFT_BRACE>, <&kp N3>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_rbrace: pd_rbrace { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RIGHT_BRACE>, <&kp N1>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_lpar: pd_lpar { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp LEFT_PARENTHESIS>, <&kp N9>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        
        pd_equal: pd_equal { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp EQUAL>, <&kp N0>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_rpar: pd_rpar { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RIGHT_PARENTHESIS>, <&kp N2>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_plus: pd_plus { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp PLUS>, <&kp N4>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_rbrc: pd_rbrc { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp RIGHT_BRACKET>, <&kp N6>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
        pd_ast: pd_ast { compatible = "zmk,behavior-mod-morph"; #binding-cells = <0>; bindings = <&kp ASTERISK>, <&kp N8>; keep-mods = <0>; mods = <(MOD_LSFT|MOD_RSFT)>; };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "ProgDvorak";
            bindings = <
  &kp DOLR  &pd_amp    &pd_lbrc  &pd_lbrace &pd_rbrace &pd_lpar &tog 1                                                                     &mo 3  &pd_equal &pd_rpar   &pd_plus  &pd_rbrc  &pd_ast   &kp EXCL
  &kp TAB   &kp SQT    &kp COMMA &kp DOT    &kp P      &kp Y    &none                                                                      &none  &kp F     &kp G      &kp C     &kp R     &kp L     &kp SLASH
  &kp ESC   &kp A      &kp O     &kp E      &kp U      &kp I    &none           &kp LCTRL &kp LALT   &kp LGUI  &kp RCTRL                 &none  &kp D     &kp H      &kp T     &kp N     &kp S     &kp MINUS
  &kp LSHFT &kp SEMI   &kp Q     &kp J      &kp K      &kp X                              &kp HOME   &kp PG_UP                                  &kp B     &kp M      &kp W     &kp V     &kp Z     &kp RSHFT
  &mo 2     &kp GRAVE  &kp CAPS  &kp LEFT   &kp RIGHT                   &kp BSPC &kp DEL   &kp END    &kp PG_DN &kp ENTER &kp SPACE                        &kp UP     &kp DOWN  &kp HASH  &kp BSLH  &mo 2
            >;
        };

        layer_keypad {
            display-name = "Keypad";
            bindings = <
  &kp EQUAL &kp N1     &kp N2    &kp N3     &kp N4     &kp N5   &trans                                                                     &mo 3  &kp N6    &kp KP_NUM &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
  &kp TAB   &kp Q      &kp W     &kp E      &kp R      &kp T    &none                                                                      &none  &kp Y     &kp KP_N7  &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp BSLH
  &kp ESC   &kp A      &kp S     &kp D      &kp F      &kp G    &none           &kp LCTRL &kp LALT   &kp LGUI  &kp RCTRL                 &none  &kp H     &kp KP_N4  &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &kp SQT
  &kp LSHFT &kp Z      &kp X     &kp C      &kp V      &kp B                              &kp HOME   &kp PG_UP                                  &kp N     &kp KP_N1  &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &kp RSHFT
  &mo 2     &kp GRAVE  &kp CAPS  &kp LEFT   &kp RIGHT                   &kp BSPC &kp DEL   &kp END    &kp PG_DN &kp ENTER &kp KP_N0                        &kp UP     &kp DOWN     &kp KP_DOT    &kp RBKT        &mo 2
            >;
        };

        layer_fn {
            display-name = "Fn";
            bindings = <
  &kp F1    &kp F2     &kp F3    &kp F4     &kp F5     &kp F6   &tog 1                                                                     &mo 3  &kp F7    &kp F8     &kp F9    &kp F10   &kp F11   &kp F12
  &trans    &trans     &trans    &trans     &trans     &trans   &none                                                                      &none  &trans    &trans     &trans    &trans    &trans    &trans
  &trans    &trans     &trans    &trans     &trans     &trans   &none           &trans    &trans     &trans    &trans                    &none  &trans    &trans     &trans    &trans    &trans    &trans
  &trans    &trans     &trans    &trans     &trans     &trans                             &trans     &trans                                     &trans    &trans     &trans    &trans    &trans    &trans
  &trans    &trans     &trans    &trans     &trans                      &trans   &trans    &trans     &trans    &trans    &trans                           &trans     &trans    &trans    &trans    &trans
            >;
        };

        layer_mod {
            display-name = "Mod";
            bindings = <
  &none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                                     &trans       &none       &none       &none   &none   &none   &none
  &none           &none         &none         &none         &none         &none         &bootloader                                                               &bootloader  &none       &none       &none   &none   &none   &none
  &studio_unlock  &none         &none         &none         &none         &none         &none         &none   &none   &bt BT_CLR &none                            &stp STP_BAT &none       &none       &none   &none   &none   &none
  &none           &none         &none         &none         &macro_ver    &none                               &none   &none                                                    &none       &none       &none   &none   &none   &none
  &none           &none         &none         &none         &none                                       &none &none   &none      &none  &bl BL_TOG &rgb_ug RGB_TOG                          &bl BL_INC  &bl BL_DEC  &none   &none   &none
            >;
        };
    };
};
